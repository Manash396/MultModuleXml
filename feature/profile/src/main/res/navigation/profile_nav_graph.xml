<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/profile_graph"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mk.profile.ProfileFragment"
        android:label="Profile">

        <deepLink
            app:uri="mkapp://profile/view"/>

        <action
            android:id="@+id/action_profile_to_edit"
            app:destination="@id/editProfileFragment" />

    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.mk.profile.EditProfileFragment"
        android:label="Edit Profile" >

        <deepLink
            app:uri="mkapp://profile/edit"/>

    </fragment>

</navigation>
